                                    <span>${{f.impact_consequence}}</span>
                                    <span>•</span>
                                    <span class="text-indigo-400 flex items-center gap-0.5"><i class="fa-solid fa-circle-nodes"></i> ${{f.phasing}} phase</span>
                                </div>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="text-[10px] font-black px-2.5 py-0.5 rounded-full uppercase tracking-wider ${{significanceColor}}">${{f.clinvar_significance || 'VUS'}}</span>
                            <span class="text-xs font-black font-mono text-slate-200 bg-slate-800 px-2 py-1 rounded">REVEL: ${{f.revel_score || 'N/A'}}</span>
                        </div>
                    </div>

                    <!-- Expandable Predictor Consensus drawer conforming to multimodal_15 -->
                    <div class="hidden bg-slate-950/80 border-t border-slate-800 p-4 text-xs space-y-4" id="details-${{idx}}">
                        <!-- Predictors grid -->
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-center">
