                                <div class="text-[10px] text-slate-500 font-extrabold uppercase mb-1">AlphaMissense</div>
                                <span class="bg-red-500/10 text-red-400 border border-red-500/20 px-2 py-0.5 rounded-full text-[10px] font-bold">Likely Pathogenic</span>
                            </div>
                            <div class="bg-slate-900/80 border border-slate-800 p-2.5 rounded-lg">
                                <div class="text-[10px] text-slate-500 font-extrabold uppercase mb-1">SpliceAI Delta</div>
                                <span class="font-mono text-white font-bold">0.89 (High Splice)</span>
