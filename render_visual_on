                </div>
            </div>`;
        }}

        function toggleVariantDetails(idx) {{
            const details = document.getElementById(`details-${{idx}}`);
            const chevron = document.getElementById(`chevron-${{idx}}`);
            if (details.classList.contains("hidden")) {{
                details.classList.remove("hidden");
                chevron.classList.add("rotate-180");
            }} else {{
                details.classList.add("hidden");
                chevron.classList.remove("rotate-180");
            }}
        }}

        // Dynamic BioGRID Protein Interaction Network visualization using D3
        function initializeBioGRIDNetwork() {{
            const svg = d3.select("#interactionNetworkSvg");
            svg.selectAll("*").remove();

            const width = document.getElementById('interactionsContent').clientWidth - 40;
            const height = 300;

            const nodes = [
                {{ id: currentActiveGene, label: currentActiveGene, color: "#ef4444", size: 15 }},
                {{ id: "TP53", label: "TP53", color: "#10b981", size: 10 }},
                {{ id: "AKT1", label: "AKT1", color: "#10b981", size: 10 }},
                {{ id: "PIK3R1", label: "PIK3R1", color: "#10b981", size: 10 }},
                {{ id: "EP300", label: "EP300", color: "#10b981", size: 10 }}
            ];

            const links = [
                {{ source: currentActiveGene, target: "TP53" }},
                {{ source: currentActiveGene, target: "AKT1" }},
                {{ source: currentActiveGene, target: "PIK3R1" }},
                {{ source: "TP53", target: "EP300" }}
            ];

            const simulation = d3.forceSimulation(nodes)
                .force("link", d3.forceLink(links).id(d => d.id).distance(80))
                .force("charge", d3.forceManyBody().strength(-150))
                .force("center", d3.forceCenter(width / 2, height / 2));

            const link = svg.append("g")
                .selectAll("line")
                .data(links)
                .join("line")
                .attr("stroke", "#475569")
                .attr("stroke-opacity", 0.6)
                .attr("stroke-width", 1.5);

            const node = svg.append("g")
                .selectAll("g")
                .data(nodes)
                .join("g");

            node.append("circle")
                .attr("r", d => d.size)
                .attr("fill", d => d.color);

            node.append("text")
                .text(d => d.label)
                .attr("x", d => d.size + 4)
                .attr("y", 3)
                .attr("fill", "#94a3b8")
                .attr("font-size", "10px");

            simulation.on("tick", () => {{
                link
                    .attr("x1", d => d.source.x)
                    .attr("y1", d => d.source.y)
                    .attr("x2", d => d.target.x)
                    .attr("y2", d => d.target.y);

                node
                    .attr("transform", d => `translate(${{d.x}}, ${{d.y}})`);
            }});
        }}

        // Tab selection logic
        function switchTab(tabId) {{
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.getElementById(`tab-${{tabId}}`).classList.add('active');

            // Hide all tab contents
            document.getElementById("overviewContent").classList.add("hidden");
            document.getElementById("variantsContent").classList.add("hidden");
            document.getElementById("phenotypesContent").classList.add("hidden");
            document.getElementById("interactionsContent").classList.add("hidden");
            document.getElementById("publicationsContent").classList.add("hidden");

            // Show selected tab content
            document.getElementById(`${{tabId}}Content`).classList.remove("hidden");
        }}

        // Run setup on load
        window.addEventListener('load', () => {{
            initializeD3Tree();
        }});
    </script>
</body>
</html>"""

