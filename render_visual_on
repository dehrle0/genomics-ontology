    <!-- Embedded Client-Side Genomics DB -->
    <script>
        const monogenicFindings = {monogenic_json};
        const polygenicFindings = {polygenic_json};
        const pharmaFindings = {pharma_json};

        let currentActiveGene = null;
        let d3GraphLoaded = false;
        let currentLayout = 'force'; // 'force' or 'hierarchical'

        // Pre-organize systems and phenotypes
        const organSystems = {{
            "HP:0001626": "Cardiovascular",
            "HP:0002715": "Immune",
            "HP:0000707": "Nervous",
            "HP:0000924": "Skeletal",
            "HP:0001939": "Metabolism",
            "HP:0002664": "Neoplasm / Oncology",
            "HP:0001871": "Blood / Tissues",
            "HP:0003011": "Musculature",
            "HP:0002086": "Respiratory",
            "HP:0000119": "Genitourinary",
            "HP:0000478": "Eye",
            "HP:0000818": "Endocrine",
            "HP:0025031": "Digestive"
        }};

        // Build data structure for D3 representation
        function getD3GraphData() {{
            const nodes = [];
            const links = [];
            const addedNodes = new Set();

            // Add Patient Root Node
            nodes.push({{ id: "patient", label: "{patient_id}", type: "patient", size: 25, color: "#38bdf8" }});
            addedNodes.add("patient");

            // Build Level 1 Systems
            Object.entries(organSystems).forEach(([curie, name]) => {{
                // Check if this system has any matching monogenic or polygenic records
                const hasMono = monogenicFindings.some(f => f.associated_hpo_terms.includes(curie));
                const hasPoly = polygenicFindings.some(p => p.hpo_level1_system === curie);
                
                if (hasMono || hasPoly) {{
                    nodes.push({{ id: curie, label: name, type: "system", size: 18, color: "#1d4ed8" }});
                    links.push({{ source: "patient", target: curie }});
                    addedNodes.add(curie);
                }}
            }});

            // Build Genes mapped to Systems
            monogenicFindings.forEach(f => {{
                const geneId = f.gene_symbol;
                if (!addedNodes.has(geneId)) {{
                    // Determine ClinVar significance color code
                    let geneColor = "#a855f7"; // purple by default
                    if (f.clinvar_significance && f.clinvar_significance.includes("Pathogenic")) {{
                        geneColor = "#ef4444"; // pathogenic red
                    }} else if (f.clinvar_significance && f.clinvar_significance.includes("VUS")) {{
                        geneColor = "#eab308"; // VUS yellow
                    }}
                    nodes.push({{ id: geneId, label: geneId, type: "gene", size: 12, color: geneColor }});
                    addedNodes.add(geneId);
                }}

                f.associated_hpo_terms.forEach(hpo => {{
                    if (addedNodes.has(hpo) && !links.some(l => l.source === hpo && l.target === geneId)) {{
                        links.push({{ source: hpo, target: geneId }});
                    }}
                }});
            }});

            return {{ nodes, links }};
        }}

        // Initialize D3 Force Directed Network Tree
        let d3Simulation = null;
        let d3ZoomBehavior = null;
        let svgGroup = null;

        function initializeD3Tree() {{
            const data = getD3GraphData();
            const width = document.getElementById('canvasContainer').clientWidth;
            const height = document.getElementById('canvasContainer').clientHeight;

            const svg = d3.select("#hpoTreeSvg");
            svg.selectAll("*").remove(); // Clean canvas

            svgGroup = svg.append("g");

            // Setup Zoom
            d3ZoomBehavior = d3.zoom()
                .scaleExtent([0.1, 4])
                .on("zoom", (event) => {{
                    svgGroup.attr("transform", event.transform);
                }});
            svg.call(d3ZoomBehavior);

            // Simulation forces
            d3Simulation = d3.forceSimulation(data.nodes)
                .force("link", d3.forceLink(data.links).id(d => d.id).distance(120))
                .force("charge", d3.forceManyBody().strength(-300))
                .force("center", d3.forceCenter(width / 2, height / 2))
                .force("collision", d3.forceCollide().radius(d => d.size + 15));

            // Draw Links
            const link = svgGroup.append("g")
                .selectAll("line")
                .data(data.links)
                .join("line")
                .attr("class", "node-link")
                .attr("stroke", "#334155")
                .attr("stroke-opacity", 0.6)
                .attr("stroke-width", 2);

            // Draw Nodes
            const node = svgGroup.append("g")
                .selectAll("g")
                .data(data.nodes)
                .join("g")
                .call(drag(d3Simulation));

            node.append("circle")
                .attr("r", d => d.size)
                .attr("fill", d => d.color)
                .attr("class", "node-circle shadow-lg")
                .on("click", (event, d) => {{
                    event.stopPropagation();
                    if (d.type === "gene") {{
                        inspectGene(d.id);
                    }} else if (d.type === "system") {{
                        inspectSystem(d.id);
                    }}
                }});

            node.append("text")
                .text(d => d.label)
                .attr("x", d => d.size + 6)
                .attr("y", 4)
                .attr("fill", "#f1f5f9")
                .attr("font-size", "11px")
                .attr("font-weight", "bold")
                .attr("class", "pointer-events-none drop-shadow-[0_1.2px_1.2px_rgba(0,0,0,0.8)]");

            d3Simulation.on("tick", () => {{
                link
                    .attr("x1", d => d.source.x)
                    .attr("y1", d => d.source.y)
                    .attr("x2", d => d.target.x)
                    .attr("y2", d => d.target.y);

                node
                    .attr("transform", d => `translate(${{d.x}}, ${{d.y}})`);
            }});

            // Drag behaviors
            function drag(simulation) {{
                function dragstarted(event, d) {{
                    if (!event.active) simulation.alphaTarget(0.3).restart();
                    d.fx = d.x;
                    d.fy = d.y;
                }}
                
                function dragged(event, d) {{
                    d.fx = event.x;
                    d.fy = event.y;
                }}
                
                function dragended(event, d) {{
                    if (!event.active) simulation.alphaTarget(0);
                    d.fx = null;
                    d.fy = null;
                }}
                
                return d3.drag()
                    .on("start", dragstarted)
                    .on("drag", dragged)
                    .on("end", dragended);
            }}
        }}

        function toggleLayout(type) {{
            // Custom layout transition block
            currentLayout = currentLayout === 'force' ? 'hierarchical' : 'force';
            if (currentLayout === 'hierarchical') {{
                // Transitions to a tidy hierarchical layout
                d3Simulation.stop();
                const data = getD3GraphData();
                const width = document.getElementById('canvasContainer').clientWidth;
                const height = document.getElementById('canvasContainer').clientHeight;

                // Simple tree layout conversion
                data.nodes.forEach((node, idx) => {{
                    if (node.type === "patient") {{
                        node.x = 80;
                        node.y = height / 2;
                    }} else if (node.type === "system") {{
                        node.x = 220;
                        node.y = (idx * (height / 8)) + 50;
                    }} else {{
                        node.x = 420;
                        node.y = (idx * (height / 20)) + 30;
                    }}
                }});

                d3.selectAll("circle")
                    .transition().duration(800)
                    .attr("cx", d => d.x)
                    .attr("cy", d => d.y);

                initializeD3Tree();
            }} else {{
                initializeD3Tree();
            }}
        }}

        function resetZoom() {{
            if (d3ZoomBehavior) {{
                d3.select("#hpoTreeSvg").transition().duration(700).call(
                    d3ZoomBehavior.transform,
                    d3.zoomIdentity
                );
            }}
        }}

        // Inspect Gene - Populate complete Tabbed details conforming to multimodal_15/16
        function inspectGene(geneSymbol) {{
            currentActiveGene = geneSymbol;
            const records = monogenicFindings.filter(f => f.gene_symbol === geneSymbol);
            if (!records.length) return;

            const primaryRecord = records[0];

            // Activate right panel header
            document.getElementById("placeholderContent").classList.add("hidden");
            document.getElementById("overviewContent").classList.remove("hidden");
            switchTab("overview");

            // Update Header Information
            document.getElementById("headerTitle").innerText = geneSymbol;
            document.getElementById("headerTag").innerText = primaryRecord.zygosity;
            document.getElementById("headerSubtitle").innerText = primaryRecord.ncbi_description || "Genomic transcript annotation panel";
            
            // Set Zygosity based badge colors
            const headerTag = document.getElementById("headerTag");
            headerTag.className = "px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider ";
            if (primaryRecord.clinvar_significance && primaryRecord.clinvar_significance.includes("Pathogenic")) {{
                headerTag.className += "bg-red-500/20 text-red-400 border border-red-500/30";
                document.getElementById("headerIcon").innerText = "🔴";
            }} else {{
                headerTag.className += "bg-yellow-500/20 text-yellow-400 border border-yellow-500/30";
                document.getElementById("headerIcon").innerText = "🟡";
            }}

            // 1. POPULATE OVERVIEW TAB
